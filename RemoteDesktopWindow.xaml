<Window x:Class="LanChat.RemoteDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程桌面" Width="1120" Height="760" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#101218" Foreground="{StaticResource OnSurfaceBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp" PreviewMouseDown="Window_PreviewMouseDown" Closing="Window_Closing" Deactivated="Window_Deactivated" StateChanged="Window_StateChanged">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="2,0,2,12">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="远程桌面" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="InputCaptureStatus" Text="键盘已锁定到远端 · Ctrl+Alt 释放键盘 · 窗口失焦时自动释放" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Content="结束远程控制" DockPanel.Dock="Right" Background="#739CFF" Foreground="White" Click="End_Click"/>
        </DockPanel>
        <Border Grid.Row="1" Background="#090B10" BorderBrush="#343946" BorderThickness="1" CornerRadius="18" Padding="8">
            <Grid>
                <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True" MouseMove="ScreenImage_MouseMove" MouseDown="ScreenImage_MouseDown" MouseUp="ScreenImage_MouseUp" MouseWheel="ScreenImage_MouseWheel" LostMouseCapture="ScreenImage_LostMouseCapture"/>
                <TextBlock x:Name="WaitText" Text="正在等待对方屏幕画面…" Foreground="#D0D2DB" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
