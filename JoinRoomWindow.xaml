<Window x:Class="LanChat.JoinRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加入聊天室" Width="560" Height="570" MinHeight="480" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{StaticResource AppFontFamily}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="28" Padding="26" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="加入聊天室" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogSubtitle" Text="输入房间地址，或从局域网发现房间" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="📌 置顶" Padding="10,6" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,8,0" />
                    <Button Content="✕" ToolTip="关闭窗口" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource OnSurfaceBrush}" Padding="10,6" Click="CloseWindow_Click" />
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,20,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="HostInput" Grid.Column="0" ToolTip="主机 IPv4 地址" VerticalContentAlignment="Center" />
                <TextBox x:Name="PortInput" Grid.Column="1" Text="47821" Margin="8,0,0,0" ToolTip="端口" VerticalContentAlignment="Center" />
                <Button x:Name="SearchButton" Grid.Column="2" Content="搜索" Click="SearchButton_Click" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentTextBrush}" Padding="14,8" Margin="8,0,0,0" />
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="发现的聊天室" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,7" />
                <ListBox x:Name="RoomsList" Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" SelectionChanged="RoomsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="9" BorderBrush="{DynamicResource ChipBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="230" />
                                    <TextBlock Text="{Binding Endpoint}" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding LockLabel}" Foreground="{DynamicResource PrimaryBrush}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="房间名（手动加入时可留空）" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,6" />
                    <TextBox x:Name="RoomNameInput" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="房间密码（如有）" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,6" />
                    <PasswordBox x:Name="PasswordInput" Padding="14,11" FontSize="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,7,0,0" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,19,0,0">
                <Button Content="取消" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource AccentTextBrush}" Click="Cancel_Click" Margin="0,0,10,0" />
                <Button Content="加入聊天室" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" Click="Join_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
