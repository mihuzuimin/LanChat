<Window x:Class="LanChat.JoinRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加入聊天室" Width="580" Height="640" MinHeight="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="26" Padding="28" Background="{DynamicResource CardGradientBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#1B2333" Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- 标题 -->
            <DockPanel>
                <Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0" DockPanel.Dock="Left">
                    <TextBlock Text="↗" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitle" Text="加入聊天室" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogSubtitle" Text="输入房间地址，或从局域网发现房间" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="📌" ToolTip="窗口置顶" Padding="9,5" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,7,0" />
                    <Button Content="✕" ToolTip="关闭窗口" Padding="9,5" Click="CloseWindow_Click" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 连接地址 -->
                <StackPanel>
                    <TextBlock Text="房主地址" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="HostInput" ToolTip="主机 IPv4 地址" VerticalContentAlignment="Center" />
                        <TextBox x:Name="PortInput" Grid.Column="1" Text="47821" Margin="8,0,0,0" ToolTip="端口" VerticalContentAlignment="Center" />
                        <Button x:Name="SearchButton" Grid.Column="2" Content="搜索房间" Click="SearchButton_Click" Padding="14,8" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="发现的聊天室" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="2,16,0,7" />

                <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="16" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" Padding="5">
                    <ListBox x:Name="RoomsList" SelectionChanged="RoomsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="#" FontSize="15" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Endpoint}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding LockLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,7,0">
                        <TextBlock Text="房间名（手动加入时可留空）" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,6" />
                        <TextBox x:Name="RoomNameInput" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                        <TextBlock Text="房间密码（如有）" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,6" />
                        <PasswordBox x:Name="PasswordInput" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" Margin="2,9,0,0" TextWrapping="Wrap" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,10,0" Padding="20,9" />
                <Button Content="加入聊天室" Style="{StaticResource PrimaryButton}" Click="Join_Click" IsDefault="True" Padding="22,9" />
            </StackPanel>
        </Grid>
    </Border>
</Window>