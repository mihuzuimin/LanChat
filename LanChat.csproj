<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.5</Version>
    <AssemblyVersion>1.1.5.0</AssemblyVersion>
    <FileVersion>1.1.5.0</FileVersion>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\MiSans-Regular.otf" />
    <Resource Include="Fonts\MiSans-Bold.otf" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ThirdPartyNotices.txt" />
    <EmbeddedResource Include="third_party\rustdesk-1.5.3-x86_64.exe;third_party\rustdesk-1.5.3-corresponding-source.zip;third_party\AGPL-3.0.txt">
      <LogicalName>LanChat.RustDesk.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
