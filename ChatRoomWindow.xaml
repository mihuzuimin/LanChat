<Window x:Class="LanChat.ChatRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanChat"
        Title="聊天室" Width="1000" Height="740" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}" Closing="Window_Closing" AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="22" Padding="18" Margin="0,0,0,16">
            <DockPanel>
                <Border Width="44" Height="44" CornerRadius="16" Background="{DynamicResource LineBrush}" Margin="0,0,13,0" DockPanel.Dock="Left">
                    <TextBlock Text="#" FontSize="25" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="RoomTitle" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="RoomSubtitle" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,3,0,0" />
                    <StackPanel x:Name="RemoteControlStatusPanel" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="RemoteControlStatusText" Text="远程控制进行中" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" VerticalAlignment="Center" />
                        <Button Content="立即结束" Click="StopRemoteControlFromChat_Click" Padding="9,3" Margin="10,0,0,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="14" Padding="11,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="房主 · 局域网" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ToggleButton Content="📌 置顶" Padding="9,5" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,7,0" />
                        <Button Content="✕" ToolTip="关闭聊天室窗口" Padding="9,5" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource OnSurfaceBrush}" Click="CloseWindow_Click" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="MemberColumn" Width="0"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="18" Margin="0,0,10,0">
            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Border x:Name="Bubble" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="16" Padding="13" HorizontalAlignment="Left" MaxWidth="720">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制消息" Click="CopyMessage_Click"/>
                                            <MenuItem Header="回复消息" Click="ReplyMessage_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding Time}" FontSize="10" Foreground="{DynamicResource SubtleBrush}" DockPanel.Dock="Right" Margin="14,0,0,0" />
                                        </DockPanel>
                                        <Border x:Name="QuoteBlock" Visibility="{Binding QuoteVisibility}" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3,0,0,0" CornerRadius="6" Padding="9,6" Margin="0,0,0,7"
                                                Cursor="Hand" ToolTip="点击跳转到被引用的消息" MouseLeftButtonUp="Quote_Click">
                                            <StackPanel>
                                                <TextBlock Text="{Binding QuoteSender}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding QuoteText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <local:MentionTextBlock SourceText="{Binding Text}" TextWrapping="Wrap" FontSize="14" FontFamily="{StaticResource AppFontFamilyEmoji}" />
                                        <Image Source="{Binding Thumbnail}" MaxWidth="420" MaxHeight="300" Stretch="Uniform" Margin="0,8,0,0" Visibility="{Binding ThumbnailVisibility}" />
                                        <TextBlock Text="{Binding AttachmentLabel}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,5,0,0" />
                                        <Button Content="下载附件…" Click="Download_Click" HorizontalAlignment="Left" Padding="11,6" Margin="0,7,0,0" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentTextBrush}" Visibility="{Binding DownloadVisibility}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SystemNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="11,4" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                               TextAlignment="Center" FontFamily="{StaticResource AppFontFamilyEmoji}" MaxWidth="640" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                    <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="SystemNotice" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
          </Border>
          <Border x:Name="MemberPanel" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="12" Visibility="Collapsed">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="房间成员" FontSize="15" FontWeight="SemiBold" Margin="4,4,4,10"/>
              <ListBox x:Name="MembersList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OnSurfaceBrush}" ContextMenuOpening="MembersList_ContextMenuOpening" PreviewMouseRightButtonDown="MembersList_PreviewMouseRightButtonDown">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                  <ContextMenu x:Name="MemberContextMenu">
                    <MenuItem Header="复制用户名" Click="CopyMemberName_Click"/>
                    <MenuItem Header="复制 IP" Click="CopyMemberIp_Click"/>
                    <Separator/>
                    <MenuItem Header="切换禁言" Tag="/mute" Click="MemberCommand_Click"/><MenuItem Header="踢出" Tag="/kick" Click="MemberCommand_Click"/>
                    <MenuItem Header="封禁用户" Tag="/ban" Click="MemberCommand_Click"/><MenuItem Header="封禁 IP" Tag="/ipban" Click="MemberCommand_Click"/>
                    <Separator/>
                    <MenuItem Header="艾特 TA" Click="MentionMember_Click"/>
                    <MenuItem x:Name="AdminToggleItem" Header="设为管理员" Click="ToggleAdmin_Click"/>
                    <MenuItem Header="请求远程控制" Click="RequestRemoteControl_Click"/>
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
            </DockPanel>
          </Border>
          <Border x:Name="MentionPanel" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Margin="10,0,0,10" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="4"
                  Panel.ZIndex="20" MaxHeight="220">
              <ListBox x:Name="MentionList" Width="200" Background="Transparent" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="MentionList_MouseUp">
                  <ListBox.ItemTemplate>
                      <DataTemplate>
                          <TextBlock Text="{Binding}" Padding="8,5" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                  </ListBox.ItemTemplate>
                  <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                          <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                          <Setter Property="Template">
                              <Setter.Value>
                                  <ControlTemplate TargetType="ListBoxItem">
                                      <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="2,0">
                                          <ContentPresenter />
                                      </Border>
                                      <ControlTemplate.Triggers>
                                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Trigger>
                                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LineBrush}" /></Trigger>
                                      </ControlTemplate.Triggers>
                                  </ControlTemplate>
                              </Setter.Value>
                          </Setter>
                      </Style>
                  </ListBox.ItemContainerStyle>
              </ListBox>
          </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="22" Padding="12" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Margin="2,0,0,10">
                    <ToggleButton x:Name="MembersToggle" Content="成员列表" Checked="MembersToggle_Changed" Unchecked="MembersToggle_Changed" Padding="12,7" Margin="0,0,8,0" />
                    <Button Content="封禁列表" Click="ShowBanList_Click" Padding="12,7" Margin="0,0,8,0" />
    <Button Content="😊 表情" Click="Emoji_Click" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentTextBrush}" Padding="12,7" Margin="0,0,8,0" />
                    <Button x:Name="SendFileButton" Content="发送文件" Click="File_Click" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentTextBrush}" Padding="12,7" Margin="0,0,8,0" />
                    <Button x:Name="SendImageButton" Content="发送图片" Click="Image_Click" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentTextBrush}" Padding="12,7" />
                    <Button Content="默认下载位置…" Click="DownloadFolder_Click" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource AccentTextBrush}" Padding="12,7" Margin="8,0,0,0" />
                    <ComboBox x:Name="SendShortcutSelector" Width="150" Margin="8,0,0,0" VerticalContentAlignment="Center" SelectionChanged="SendShortcutSelector_SelectionChanged">
                        <ComboBoxItem Content="Ctrl+Enter 发送" Tag="CtrlEnter" />
                        <ComboBoxItem Content="Enter 发送" Tag="Enter" />
                    </ComboBox>
                    <TextBlock Text="房主指令：/mute、/kick、/ban、/ipban、/unban、/unipban 用户名或IP" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0" />
                </WrapPanel>
                <Border x:Name="UploadProgressPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="10,7" Margin="2,0,2,9">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="UploadProgressText" Text="正在准备上传…" FontSize="11" Foreground="{DynamicResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UploadProgressPercent" DockPanel.Dock="Right" Text="0%" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" />
                        </DockPanel>
                        <ProgressBar x:Name="UploadProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True" SnapsToDevicePixels="True">
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4" />
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="ReplyBar" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="✕" Foreground="{DynamicResource MutedBrush}" FontSize="14" Padding="6,0" Cursor="Hand"
                                       ToolTip="取消引用" VerticalAlignment="Top" MouseLeftButtonUp="CancelReply_Click" />
                            <StackPanel>
                                <TextBlock x:Name="ReplySenderText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ReplyPreviewText" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <RichTextBox x:Name="MessageInput" MinHeight="46" MaxHeight="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Center" FontFamily="{StaticResource AppFontFamilyEmoji}"
                                     PreviewKeyDown="MessageInput_PreviewKeyDown" TextChanged="MessageInput_TextChanged"
                                     SelectionChanged="MessageInput_SelectionChanged" LostKeyboardFocus="MessageInput_LostKeyboardFocus" />
                        <Button Grid.Column="1" Content="发送" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" Click="Send_Click" Margin="10,0,0,0" Padding="22,10" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
