<Window x:Class="LanChat.BanListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="封禁列表" Width="520" Height="460" MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="封禁列表" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ToggleButton Content="📌 置顶" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,8,0"/>
                <Button Content="✕" ToolTip="关闭窗口" Click="Close_Click" Padding="9,5"/>
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="BansList" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource OnSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" SelectionChanged="BansList_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="5"><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource MutedBrush}" Width="110"/><TextBlock Text="{Binding Target}" FontWeight="SemiBold"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="EmptyHint" Text="当前没有被封禁的用户或 IP。" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="UnbanUserButton" Content="解封用户" Click="UnbanUser_Click" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="UnbanIpButton" Content="解封用户 IP" Click="UnbanIp_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
