<Window x:Class="LanChat.BanListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="封禁列表" Width="540" Height="480" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <DockPanel Margin="2,0,2,16">
            <Border Width="40" Height="40" CornerRadius="13" Background="{DynamicResource DangerSoftBrush}" Margin="0,0,12,0" DockPanel.Dock="Left">
                <TextBlock Text="⊘" FontSize="19" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="封禁列表" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="管理当前房间中被限制的用户与 IP" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <ToggleButton Content="📌 置顶" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,8,0"/>
                <Button Content="✕" ToolTip="关闭窗口" Click="Close_Click" Padding="9,5"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardGradientBrush}" CornerRadius="18" Padding="8" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
            <ListBox x:Name="BansList" SelectionChanged="BansList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource ChipBrush}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Target}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="2" Margin="2,16,2,0">
            <TextBlock x:Name="EmptyHint" Text="当前没有被封禁的用户或 IP。" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="UnbanUserButton" Content="解封用户" Click="UnbanUser_Click" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="UnbanIpButton" Content="解封用户 IP" Click="UnbanIp_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>