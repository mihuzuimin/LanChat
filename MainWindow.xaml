<Window x:Class="LanChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="局域聊天室" Width="1000" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid x:Name="HomePage" Margin="30,24,30,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <DockPanel Grid.Row="0" Margin="2,0,2,24">
            <Border Width="46" Height="46" CornerRadius="15" Margin="0,0,14,0" DockPanel.Dock="Left" Background="{DynamicResource PrimaryGradientBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#FF6900" Opacity="0.3" />
                </Border.Effect>
                <TextBlock Text="✉" FontSize="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Content="设置" Click="SettingsButton_Click" Padding="16,8" Margin="0,0,8,0" />
                <Button x:Name="HelpButton" Content="帮助" Click="HelpButton_Click" Padding="16,8" Margin="0,0,8,0" />
                <ToggleButton x:Name="LogToggle" Content="运行日志" Padding="14,8" Margin="0,0,8,0" Checked="LogToggle_Checked" Unchecked="LogToggle_Unchecked" />
                <ToggleButton Content="📌 置顶" Padding="14,8" Margin="0,0,8,0" Checked="Pin_Checked" Unchecked="Pin_Unchecked" />
                <Button x:Name="UsernameButton" Content="输入用户名" Style="{StaticResource PrimaryButton}" Click="UsernameButton_Click" Padding="20,8" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="局域聊天室" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="和同一局域网中的朋友轻松交流" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="24"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions>

            <!-- 主视觉卡片 -->
            <Border Grid.Column="0" CornerRadius="30" Padding="40" Background="{DynamicResource HeroGradientBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Color="#FF6900" Opacity="0.28" />
                </Border.Effect>
                <Grid>
                    <!-- 装饰圆环 -->
                    <Grid Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-30,-30" IsHitTestVisible="False">
                        <Ellipse Stroke="#66FFFFFF" StrokeThickness="1" />
                        <Ellipse Width="180" Height="180" Stroke="#4DFFFFFF" StrokeThickness="1" />
                        <Ellipse Width="104" Height="104" Stroke="#3DFFFFFF" StrokeThickness="1" />
                    </Grid>
                    <Grid Width="180" Height="180" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-46,0,0,-52" IsHitTestVisible="False">
                        <Ellipse Fill="#1AFFFFFF" />
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" MaxWidth="470" HorizontalAlignment="Left">
                            <Border Background="#33FFFFFF" CornerRadius="20" Padding="13,7" HorizontalAlignment="Left" Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#B7F5D8" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="局域网直连 · 即开即用" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="让交流，&#xA;从一个房间开始。" FontSize="34" FontWeight="Bold" LineHeight="47" Foreground="#FFFFFF" />
                            <TextBlock Text="创建一个新聊天室，或找到已有房间继续对话。所有消息都在局域网内直达，无需外网。"
                                       TextWrapping="Wrap" FontSize="13.5" LineHeight="24" Foreground="#FFE7D6" Margin="0,18,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,28,0,0">
                            <Border Background="#2BFFFFFF" CornerRadius="18" Padding="14,8" Margin="0,0,10,0">
                                <TextBlock Text="⚡ 低延迟" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#2BFFFFFF" CornerRadius="18" Padding="14,8">
                                <TextBlock Text="🔒 无需外网" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 入口 -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="开始使用" FontSize="19" FontWeight="SemiBold" Margin="4,0,0,4" />
                <TextBlock Text="选择一种方式进入聊天室" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="4,0,0,18" />

                <Button x:Name="JoinRoomButton" Style="{StaticResource CardButton}" Click="JoinRoom_Click" Margin="0,0,0,11">
                    <Grid Width="290">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="↗" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="加入指定聊天室" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="输入房间名称或邀请码" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="21" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="12,0,2,0" />
                    </Grid>
                </Button>

                <Button x:Name="SearchRoomButton" Style="{StaticResource CardButton}" Click="SearchRoom_Click" Margin="0,0,0,11">
                    <Grid Width="290">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="14" Background="{DynamicResource InfoSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="⌕" FontSize="21" Foreground="{DynamicResource InfoTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="搜索已创建的聊天室" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="浏览当前局域网的公开房间" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="21" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="12,0,2,0" />
                    </Grid>
                </Button>

                <Button x:Name="CreateRoomButton" Style="{StaticResource CardButton}" Click="CreateRoom_Click">
                    <Grid Width="290">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="14" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="＋" FontSize="20" Foreground="{DynamicResource SuccessTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="新建聊天室" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="创建房间并邀请其他人" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="21" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="12,0,2,0" />
                    </Grid>
                </Button>

                <TextBlock x:Name="ActionHint" Text="请选择一个选项" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="5,16,0,0" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="6,18,6,0">
            <TextBlock Text="局域聊天室" FontSize="11" Foreground="{DynamicResource SubtleBrush}" DockPanel.Dock="Left" />
            <TextBlock Text="主页面" FontSize="11" Foreground="{DynamicResource SubtleBrush}" DockPanel.Dock="Right" />
        </DockPanel>
        </Grid>

        <!-- 聊天室页面（单窗口内切换） -->
        <Grid x:Name="RoomPage" Visibility="Collapsed" />
    </Grid>
</Window>
