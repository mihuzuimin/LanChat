<UserControl x:Class="LanChat.ChatRoomView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent" Foreground="{DynamicResource OnSurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- 房间信息 -->
        <Border Grid.Row="0" CornerRadius="22" Padding="16,14" Margin="0,0,0,14" Background="{DynamicResource CardGradientBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Color="#2A3346" Opacity="0.06" />
            </Border.Effect>
            <DockPanel>
                <Border Width="44" Height="44" CornerRadius="15" Background="{DynamicResource PrimaryGradientBrush}" Margin="0,0,13,0" DockPanel.Dock="Left">
                    <TextBlock Text="#" FontSize="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="14" Padding="10,5" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="RoleBadgeText" Text="房主 · 局域网" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ToggleButton Content="📌 置顶" Padding="11,5" MinHeight="32" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,6,0" />
                    <Button Content="✕" ToolTip="关闭聊天室窗口" Click="CloseWindow_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="RoomTitle" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="RoomSubtitle" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,10,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 消息与成员 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="MemberColumn" Width="0"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource CardGradientBrush}" CornerRadius="24" Padding="14" Margin="0,0,10,0"
                    BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
                <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,0,2,12">
                                    <!-- 系统消息 -->
                                    <Border x:Name="SystemBubble" Visibility="Collapsed" Background="{DynamicResource ChipBrush}" BorderBrush="Transparent" BorderThickness="0"
                                            CornerRadius="12" Padding="12,7" HorizontalAlignment="Center" MaxWidth="620">
                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" />
                                    </Border>

                                    <!-- 聊天气泡 -->
                                    <Border x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="640" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="Transparent" BorderThickness="0"
                                            CornerRadius="6,18,18,18" Padding="14,11">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="引用该消息" Click="QuoteMessage_Click" />
                                                <MenuItem Header="复制文本" Click="CopyMessage_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel>
                                            <Border x:Name="QuoteBox" Visibility="{Binding QuoteVisibility}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="9,6" Margin="0,0,0,8">
                                                <TextBlock x:Name="QuoteTextBlock" Text="{Binding Quote}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock x:Name="SenderText" Text="{Binding Sender}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Left" />
                                                <TextBlock x:Name="TimeText" Text="{Binding Time}" FontSize="10" Foreground="{DynamicResource SubtleBrush}" DockPanel.Dock="Right" Margin="16,0,0,0" />
                                            </DockPanel>
                                            <TextBlock x:Name="BodyText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" LineHeight="22" Foreground="{DynamicResource OnSurfaceBrush}"
                                                       FontFamily="{StaticResource AppFontFamilyEmoji}" />
                                            <Image Source="{Binding Thumbnail}" MaxWidth="420" MaxHeight="300" Stretch="Uniform" HorizontalAlignment="Left"
                                                   Margin="0,9,0,0" Visibility="{Binding ThumbnailVisibility}" />
                                            <TextBlock x:Name="AttachmentText" Text="{Binding AttachmentLabel}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,6,0,0" />
                                            <Button x:Name="DownloadButton" Content="下载附件…" Click="Download_Click" HorizontalAlignment="Left" Padding="13,6" FontSize="11.5"
                                                    MinHeight="30" Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}" Foreground="{DynamicResource AccentTextBrush}"
                                                    Visibility="{Binding DownloadVisibility}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                        <Setter TargetName="SystemBubble" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
                                        <Setter TargetName="Bubble" Property="CornerRadius" Value="18,6,18,18" />
                                        <Setter TargetName="SenderText" Property="Foreground" Value="#FFE7D6" />
                                        <Setter TargetName="TimeText" Property="Foreground" Value="#FFDCC2" />
                                        <Setter TargetName="BodyText" Property="Foreground" Value="#FFFFFF" />
                                        <Setter TargetName="AttachmentText" Property="Foreground" Value="#FFE7D6" />
                                        <Setter TargetName="QuoteBox" Property="Background" Value="#2BFFFFFF" />
                                        <Setter TargetName="QuoteBox" Property="BorderBrush" Value="#4DFFFFFF" />
                                        <Setter TargetName="QuoteTextBlock" Property="Foreground" Value="#FFFFFF" />
                                        <Setter TargetName="DownloadButton" Property="Background" Value="#33FFFFFF" />
                                        <Setter TargetName="DownloadButton" Property="BorderBrush" Value="#66FFFFFF" />
                                        <Setter TargetName="DownloadButton" Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border x:Name="MemberPanel" Grid.Column="1" Background="{DynamicResource CardGradientBrush}" CornerRadius="24" Padding="13" Visibility="Collapsed"
                    BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,4,12">
                        <TextBlock Text="房间成员" FontSize="14" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElementName=MembersList, Path=Items.Count}" FontSize="10.5" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <ListBox x:Name="MembersList" ContextMenuOpening="MembersList_ContextMenuOpening" PreviewMouseRightButtonDown="MembersList_PreviewMouseRightButtonDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" Margin="0,0,10,0">
                                        <Border CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" />
                                        <TextBlock Text="{Binding Initial}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="MemberContextMenu">
                                <MenuItem Header="复制用户名" Click="CopyMemberName_Click"/><MenuItem Header="复制 IP 地址" Click="CopyMemberIp_Click"/>
                                <Separator/><MenuItem x:Name="RemoteMenuItem" Header="远程控制（RustDesk）" Click="RequestRustDesk_Click"/>
                                <Separator/><MenuItem Header="切换禁言" Tag="/mute" Click="MemberCommand_Click"/><MenuItem Header="踢出" Tag="/kick" Click="MemberCommand_Click"/>
                                <MenuItem Header="封禁用户" Tag="/ban" Click="MemberCommand_Click"/><MenuItem Header="封禁 IP" Tag="/ipban" Click="MemberCommand_Click"/>
                                <Separator/><MenuItem Header="设为管理员" Tag="/admin" Click="MemberCommand_Click"/><MenuItem Header="取消管理员" Tag="/unadmin" Click="MemberCommand_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 输入区 -->
        <Border Grid.Row="2" Background="{DynamicResource CardGradientBrush}" CornerRadius="24" Padding="14,12" Margin="0,12,0,0"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 传输进度 -->
                <Border x:Name="TransferPanel" Visibility="Collapsed" Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,9" Margin="0,0,0,9">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock DockPanel.Dock="Right" x:Name="TransferPercent" Text="0%" FontSize="11" Foreground="{DynamicResource InfoTextBrush}" Margin="10,0,0,0" />
                            <TextBlock x:Name="TransferLabel" Text="正在传输…" FontSize="11.5" Foreground="{DynamicResource InfoTextBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar x:Name="TransferProgress" Height="6" Minimum="0" Maximum="100" Value="0" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- 引用栏 -->
                <Border x:Name="QuoteBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,7" Margin="0,0,0,9">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" ToolTip="取消引用" Click="CancelQuote_Click" Margin="10,0,0,0" />
                        <TextBlock x:Name="QuoteText" FontSize="11.5" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </DockPanel>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" Text="Ctrl + Enter 发送" Foreground="{DynamicResource SubtleBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <WrapPanel>
                        <ToggleButton x:Name="MembersToggle" Content="成员列表" Checked="MembersToggle_Changed" Unchecked="MembersToggle_Changed" Padding="13,6" Margin="0,0,7,0" />
                        <Button Content="封禁列表" Click="ShowBanList_Click" Padding="13,6" Margin="0,0,7,0" />
                        <ToggleButton x:Name="EmojiToggle" Content="😊 表情" Padding="13,6" Margin="0,0,7,0" Checked="EmojiToggle_Checked" Unchecked="EmojiToggle_Unchecked" />
                        <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiToggle}" Placement="Top" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade" Closed="EmojiPopup_Closed">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="8" Margin="0,0,0,6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="#2A3346" Opacity="0.16" />
                                </Border.Effect>
                                <WrapPanel x:Name="EmojiPanel" Width="286" />
                            </Border>
                        </Popup>
                        <ToggleButton x:Name="ShortcutToggle" Content="⌨ 快捷键转发"
                                      ToolTip="开启后：带修饰键的组合（Ctrl/Alt/Shift/Win+按键）将转发给远程协助对象，本机不响应；单键不受影响。按住 Ctrl+Alt 半秒可释放本机热键并关闭转发。Ctrl+Alt+Del、Win+L 属系统安全序列，无法转发。"
                                      Checked="ShortcutToggle_Checked" Unchecked="ShortcutToggle_Unchecked" Padding="13,6" Margin="0,0,7,0" />
                        <ToggleButton x:Name="ClipboardSyncToggle" Content="📋 剪贴板同步"
                                      ToolTip="开启后：复制的文字自动同步给远程协助对象（仅文字，对方也需开启同步才写入剪贴板）。"
                                      Checked="ClipboardSyncToggle_Checked" Unchecked="ClipboardSyncToggle_Unchecked" Padding="13,6" Margin="0,0,7,0" />
                        <Button Content="⇪ 发送文件" Click="File_Click" Padding="13,6" Margin="0,0,7,0" />
                        <Button Content="📁 发送文件夹" Click="Folder_Click" Padding="13,6" Margin="0,0,7,0" />
                        <Button Content="🖼 发送图片" Click="Image_Click" Padding="13,6" Margin="0,0,7,0" />
                        <Button Content="默认下载位置…" Click="DownloadFolder_Click" Padding="13,6" Foreground="{DynamicResource MutedBrush}" />
                    </WrapPanel>
                </DockPanel>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageInput" MinHeight="48" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" Padding="14,13"
                             VerticalContentAlignment="Center" FontSize="13.5" FontFamily="{StaticResource AppFontFamilyEmoji}" KeyDown="MessageInput_KeyDown" />
                    <Button Grid.Column="1" Content="发送" Style="{StaticResource PrimaryButton}" Click="Send_Click" Margin="10,0,0,0" Padding="28,10" MinWidth="88" Height="48" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
