<Window x:Class="LanChat.UserGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用帮助" Width="700" Height="720" MinWidth="580" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="4,0,0,18">
            <StackPanel>
                <TextBlock Text="使用帮助" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="局域聊天室快速指南" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Content="📌 置顶" Padding="10,6" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,8,0" />
                <Button Content="✕" ToolTip="关闭窗口" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource OnSurfaceBrush}" Padding="10,6" Click="CloseWindow_Click" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="22" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="1. 设置用户名" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="在主页点击“输入用户名”设置显示名称。加入或创建房间前必须先设置用户名。" TextWrapping="Wrap" Margin="0,7,0,18" />

                    <TextBlock Text="2. 创建聊天室" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="点击“新建聊天室”，填写房间名与端口并选择公开/私密；密码可留空。公开房间可通过局域网搜索发现；私密房间不会响应搜索，只能手动输入房间名、房主 IPv4 地址、端口和密码加入。聊天使用你填写的 TCP 端口。创建者成为房主，其他设备需在同一局域网中，并允许程序通过 Windows 防火墙通信。" TextWrapping="Wrap" Margin="0,7,0,18" />

                    <TextBlock Text="3. 加入聊天室" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="“搜索已创建的聊天室”会查找局域网广播的房间；也可以选择“加入指定聊天室”并输入房间名、房主 IPv4 地址、端口和密码。" TextWrapping="Wrap" Margin="0,7,0,18" />

                    <TextBlock Text="4. 群聊、附件与表情" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="聊天窗口工具栏的快捷键选项可选择 Enter 发送或 Ctrl+Enter 发送；当前用于发送的按键会发送消息，另一个按键用于换行。选择会自动保存。也可点击“发送”按钮。“表情”按钮会打开 Windows 表情面板，也可按 Win+. 打开。可点击“发送文件/发送图片”选择附件，也可把文件拖到聊天窗口，或在输入框粘贴从资源管理器复制的文件以自动上传；直接粘贴截图或复制的图片时会自动以图片消息发送。支持一次拖入或粘贴多个文件。图片可显示缩略图，单个附件最大 1 GB。收到附件后点击“下载附件…”并在系统保存窗口中选择路径；“默认下载位置…”可更改默认目录。被房主禁言时，程序会在本机拦截文字和附件发送。" TextWrapping="Wrap" Margin="0,7,0,18" />

                    <TextBlock Text="5. 房主管理指令" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="房主可在聊天输入框使用以下命令。用户名或 IP 含空格时暂不支持：" TextWrapping="Wrap" Margin="0,7,0,8" />
                    <Border Background="{DynamicResource ChipBrush}" CornerRadius="14" Padding="14">
                        <TextBlock FontFamily="Consolas" TextWrapping="Wrap" LineHeight="23">
                            /mute 用户名或IP — 切换禁言状态&#xA;
                            /kick 用户名或IP — 移出并阻止本房间内再次加入&#xA;
                            /ban 用户名或IP — 禁止再次加入本房间&#xA;
                            /ipban IP — 按 IP 禁止再次加入&#xA;
                            /unban 用户名或IP — 解除指定用户或 IP 封禁&#xA;
                            /unipban IP — 解除 IP 封禁&#xA;
                            /help — 显示指令用法
                        </TextBlock>
                    </Border>
                    <TextBlock Text="聊天窗口的“成员列表”可折叠显示房间成员，并通过右键菜单复制用户名/IP 或执行禁言、踢出、封禁操作。“封禁列表”可查看当前房间的封禁项并解除用户或 IP 封禁。成员和封禁信息仅在房间运行期间有效。" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="房主可以在成员列表右键“设为管理员”，该成员的访客头衔会变为管理员并获得与房主相同的管理权限：禁言、踢出、封禁、查看封禁列表（已设为管理员的成员，菜单会变为“取消管理员”）。管理员只能管理访客，不能对房主、其他管理员和自己进行管理操作。" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <TextBlock Text="禁言和封禁仅在当前房间运行期间有效。房间关闭后会清除。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,9,0,0" />

                    <TextBlock Text="10. 房间成员身份与移出提示" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,20,0,0" />
                    <TextBlock Text="聊天消息会标记创建者或访客。成员被踢出、封禁或 IP 封禁时会收到对应弹窗；之后尝试重新加入也会收到相同原因提示。相关限制仅在房间本次运行期间有效。" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <TextBlock Text="11. 远程控制" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,20,0,0" />
                    <TextBlock Text="在成员列表中右键选择“请求远程控制”。对方在 LanChat 中明确接受后，LanChat 会自动在被控端开启 RustDesk 的“直接 IP 访问”（TCP 21118）并启动内置的 RustDesk 1.5.3；随后控制端会询问连接方式：“局域网 IP 直连”适合双方在同一网段，速度最快；“RustDesk ID 连接”适合异地或跨网络，双方都需要能访问 RustDesk 公共服务器。选定后 RustDesk 会直接弹出连接窗口（后台主窗口已隐藏）。屏幕采集、键鼠操作和远控会话全部由 RustDesk 原生客户端处理，聊天室只负责申请、同意和结束信号。若 RustDesk 提示输入密码，请向对方索取其 RustDesk 主窗口显示的临时密码。关闭 RustDesk 窗口或点击聊天室中的结束按钮可结束远控。" TextWrapping="Wrap" Margin="0,7,0,8" />
                    <Border Background="{DynamicResource ChipBrush}" CornerRadius="14" Padding="13" Margin="0,0,0,8">
                        <TextBlock Text="首次被控时，Windows 可能弹出防火墙询问，请允许 RustDesk 通过专用网络；在可信任局域网中只需同意一次。被控端已手动开启“直接 IP 访问”时，LanChat 会直接复用该设置，不会改动它。RustDesk 官方说明直接 IP 模式未加密；仅在可信任的局域网使用，避免传输敏感内容。若不愿接受未加密直连，请勿继续连接。" TextWrapping="Wrap" Foreground="{DynamicResource SoftAccentBrush}" FontSize="12" />
                    </Border>
                    <TextBlock Text="RustDesk 是单独启动的原版客户端，不是嵌入 LanChat 窗口的控件。按 AGPL-3.0 分发；许可证全文与对应的 1.5.3 源码压缩包均内置于本程序，可通过下方按钮导出。版本及源码：https://github.com/rustdesk/rustdesk/tree/1.5.3。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" />

                    <TextBlock Text="12. 艾特与引用回复" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,20,0,0" />
                    <TextBlock Text="在输入框输入 @ 会自动列出房间成员，用上下键选择后按 Enter（或直接用鼠标点击）即可插入蓝色的 @用户名；也可以在成员列表右键选择“艾特 TA”直接插入。被艾特的成员会收到 Windows 通知提示“您被 xxx 艾特了”。在收到的消息上点右键，可以选择“复制消息”或“回复消息”；回复时会自动引用原消息并在输入框补上 @对方，发送后引用内容显示在消息上方；点击引用块可跳转并高亮被引用的原消息。" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <TextBlock Text="6. 窗口置顶" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,20,0,0" />
                    <TextBlock Text="每个页面都可单独点击“📌 置顶”，让当前窗口保持在其他窗口上方；取消勾选即可恢复普通层级。" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <TextBlock Text="7. 入房提示与主机关闭" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,20,0,0" />
                    <TextBlock Text="成员加入时，房间内会显示用户名和内网 IPv4 地址。房主关闭聊天室后，其他成员会看到“主机已关闭连接”提示；点击确定或等待 5 秒，聊天室窗口会自动关闭。" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <TextBlock Text="8. 实时运行日志" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,20,0,0" />
                    <TextBlock Text="在主页打开“运行日志”开关，可显示独立日志窗口并实时查看房间创建与加入、聊天消息、附件操作和连接状态。关闭开关或日志窗口即可停止显示。" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <TextBlock Text="9. 自动保存运行日志" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,20,0,0" />
                    <TextBlock Text="程序从启动时会在后台持续记录操作事件、实时房间/连接状态、监听与发现活动、消息和附件收发、异常信息及周期状态快照。退出时会在程序所在目录下的 logs 文件夹生成独立的 LanChat-runtime-时间戳.txt 文件；此文件与用户通过“保存日志”主动导出的文件分开。" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="导出 RustDesk 源码" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource AccentTextBrush}" Click="ExportRustDeskSource_Click" Margin="0,0,8,0" />
            <Button Content="导出 AGPL-3.0 许可证" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource AccentTextBrush}" Click="ExportRustDeskLicense_Click" Margin="0,0,8,0" />
            <Button Content="关闭" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
