<Window x:Class="LanChat.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="480" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="24" Padding="26" Background="{DynamicResource CardGradientBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#1B2333" Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,11,0">
                        <TextBlock Text="↑" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="发现新版本" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,0">
                <TextBlock x:Name="LatestText" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentText" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                <Border x:Name="NotesBox" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="10,7" Margin="0,10,0,0">
                    <TextBlock x:Name="NotesText" FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" Text="正在读取更新说明…" />
                </Border>
                <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" Margin="0,16,0,0" Value="0" />
                <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource AccentTextBrush}" Margin="0,9,0,0" Text="将自动下载并重启完成更新。" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExitButton" Content="退出程序" Click="Exit_Click" Padding="18,9" Margin="0,0,10,0" Background="{DynamicResource SurfaceBrush}" />
                <Button x:Name="UpdateButton" Content="立即更新" Style="{StaticResource PrimaryButton}" Click="Update_Click" Padding="24,9" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
