<Window x:Class="LanChat.ConnectionClosedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天室连接已关闭" Width="420" Height="240" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource OnSurfaceBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" Loaded="Window_Loaded">
    <Border Background="#181B22" CornerRadius="26" Padding="26" BorderBrush="#2D313B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <TextBlock Text="连接已关闭" FontSize="20" FontWeight="SemiBold" />
                <ToggleButton Content="📌 置顶" DockPanel.Dock="Right" Padding="9,5" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,7,0" />
                <Button Content="✕" Click="Close_Click" Background="#252932" Foreground="#D0D2DB" Padding="9,5" />
            </DockPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="主机已关闭连接" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="CountdownText" Text="窗口将在 5 秒后自动关闭。" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
            <Button Grid.Row="2" Content="确定" Background="#739CFF" Foreground="White" HorizontalAlignment="Right" Click="Close_Click" IsDefault="True" />
        </Grid>
    </Border>
</Window>
