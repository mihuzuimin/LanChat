<Window x:Class="LanChat.ConnectionClosedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天室连接已关闭" Width="430" Height="250" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display" Loaded="Window_Loaded">
    <Border CornerRadius="24" Padding="26" Background="{DynamicResource CardGradientBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#1B2333" Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource DangerSoftBrush}" Margin="0,0,11,0">
                        <TextBlock Text="!" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="连接已关闭" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="📌" ToolTip="窗口置顶" Padding="9,5" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,7,0" />
                    <Button Content="✕" ToolTip="关闭窗口" Click="Close_Click" Padding="9,5" />
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="主机已关闭连接" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="CountdownText" Text="窗口将在 5 秒后自动关闭。" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
            <Button Grid.Row="2" Content="确定" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Close_Click" IsDefault="True" Padding="26,9" />
        </Grid>
    </Border>
</Window>