<Window x:Class="LanChat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="500" Height="452" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="24" Padding="26" Background="{DynamicResource CardGradientBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#1B2333" Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,11,0">
                        <TextBlock Text="⚙" FontSize="18" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="📌" ToolTip="窗口置顶" Padding="9,5" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,7,0" />
                    <Button Content="✕" ToolTip="关闭窗口" Click="Close_Click" Padding="9,5" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="16,13" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="外观" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="深色模式立即生效并自动保存" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="DarkModeBox" Content="深色模式" DockPanel.Dock="Right" VerticalAlignment="Center"
                                  Checked="DarkMode_Changed" Unchecked="DarkMode_Changed" />
                    </DockPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="16,13">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="局域网更新" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="AutoCheckBox" Content="启动时自动检查（15 秒，静默）" DockPanel.Dock="Right" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <TextBlock Text="同一局域网内只要有机器运行更高版本，就会提示强制更新；更新端口固定为 9178。" FontSize="11.5"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,12,2,0" />
                <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" Margin="2,10,2,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CheckButton" Content="检查更新（5 秒）" Click="Check_Click" Padding="18,9" Margin="0,0,10,0"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}" Foreground="{DynamicResource AccentTextBrush}" />
                <Button Content="写入设置" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="22,9" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
