<Window x:Class="LanChat.RoomSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建聊天室" Width="470" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{StaticResource AppFontFamily}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="28" Padding="30" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="新建聊天室" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="设置房间信息并启动局域网群聊" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="PinToggle" Content="📌 置顶" Padding="10,6" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,8,0" />
                    <Button Content="✕" ToolTip="关闭窗口" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource OnSurfaceBrush}" Padding="10,6" Click="CloseWindow_Click" />
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="房间名" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,6" />
                <TextBox x:Name="RoomNameInput" MaxLength="48" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="房间端口（1024–65535）" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,6" />
                <TextBox x:Name="PortInput" Text="47821" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="房间密码（可选）" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,6" />
                <PasswordBox x:Name="PasswordInput" Padding="14,11" FontSize="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1" />
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,12,0,0">
                <RadioButton x:Name="PublicOption" Content="公开（可被搜索）" GroupName="RoomPrivacy" IsChecked="True" Margin="0,0,18,0" />
                <RadioButton x:Name="PrivateOption" Content="私密（仅手动加入）" GroupName="RoomPrivacy" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Grid.Row="5" VerticalAlignment="Top" Margin="2,10,0,0" FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource AccentTextBrush}" Click="Cancel_Click" Margin="0,0,10,0" />
                <Button Content="创建房间" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
