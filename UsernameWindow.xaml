<Window x:Class="LanChat.UsernameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置用户名" Width="440" Height="290" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="26" Padding="28" Background="{DynamicResource CardGradientBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#1B2333" Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0" DockPanel.Dock="Left">
                    <TextBlock Text="☺" Foreground="{DynamicResource PrimaryBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="你的用户名" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="选择一个在聊天室中显示的名称" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="📌" ToolTip="窗口置顶" Padding="9,5" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,7,0" />
                    <Button Content="✕" ToolTip="关闭窗口" Padding="9,5" Click="CloseWindow_Click" />
                </StackPanel>
            </DockPanel>
            <TextBox x:Name="UsernameInput" Grid.Row="1" Margin="0,24,0,8" MaxLength="32" VerticalContentAlignment="Center" />
            <TextBlock x:Name="ValidationText" Grid.Row="2" Text="最多 32 个字符" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,0" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,10,0" Padding="20,9" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" IsDefault="True" Padding="22,9" />
            </StackPanel>
        </Grid>
    </Border>
</Window>