<Window x:Class="LanChat.RoomAccessNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天室访问提示" Width="440" Height="270" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="24" Padding="26" Background="{DynamicResource CardGradientBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#1B2333" Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,11,0">
                        <TextBlock Text="⊘" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="聊天室访问提示" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="📌" ToolTip="窗口置顶" Padding="9,5" Margin="0,0,7,0" Checked="Pin_Checked" Unchecked="Pin_Unchecked" />
                    <Button Content="✕" ToolTip="关闭窗口" Padding="9,5" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="NoticeText" Text="您已被移出聊天室" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="如需重新加入，请联系房主。" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0" />
            </StackPanel>
            <Button Grid.Row="2" Content="确定" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Close_Click" IsDefault="True" Padding="26,9" />
        </Grid>
    </Border>
</Window>