<Window x:Class="LanChat.RoomAccessNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天室访问提示" Width="430" Height="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{StaticResource AppFontFamily}">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="26" Padding="26" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <TextBlock Text="聊天室访问提示" FontSize="19" FontWeight="SemiBold" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton Content="📌 置顶" Padding="9,5" Margin="0,0,7,0" Checked="Pin_Checked" Unchecked="Pin_Unchecked" />
                    <Button Content="✕" Padding="9,5" Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource OnSurfaceBrush}" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="NoticeText" Text="您已被移出聊天室" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="如需重新加入，请联系房主。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0" />
            </StackPanel>
            <Button Grid.Row="2" Content="确定" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Right" Click="Close_Click" IsDefault="True" />
        </Grid>
    </Border>
</Window>
