<Window x:Class="LanChat.LoggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序运行日志" Width="760" Height="480" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}" Closed="Window_Closed">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="3,0,3,14">
            <StackPanel>
                <TextBlock Text="程序运行日志" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="实时记录当前程序的房间和连接活动" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="保存日志" Click="SaveLog_Click" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentTextBrush}" Padding="12,7" Margin="0,0,8,0" />
                <ToggleButton Content="📌 置顶" Padding="10,6" Checked="Pin_Checked" Unchecked="Pin_Unchecked" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="12">
            <ListBox x:Name="EntriesList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding Entries}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                        <Setter Property="Padding" Value="7,4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
    </Grid>
</Window>
